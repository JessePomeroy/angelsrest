{
	"name": "angelsrest",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
	"engines": {
		"node": "24.x",
		"pnpm": ">=10.34.5"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:package-contract": "tsc -p packages/crm-api/tests/tsconfig.consumer.json --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "node --test scripts/vercel-ignore-build.test.mjs && vitest run && pnpm test:protocol",
		"test:watch": "vitest",
		"test:e2e": "node scripts/run-playwright.mjs",
		"test:browser": "node scripts/run-playwright.mjs --config tests/browser/playwright.config.ts",
		"smoke:gallery-host-bulk-delete": "node scripts/smoke-gallery-host-bulk-delete.mjs",
		"test:protocol": "vitest run --config vitest.protocol.config.ts",
		"test:print-contract": "vitest run --config vitest.print-contract.config.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.13",
		"@changesets/cli": "^2.31.0",
		"@edge-runtime/vm": "^5.0.0",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^25.6.0",
		"@types/three": "^0.185.4",
		"convex-test": "^0.0.52",
		"dotenv": "^17.4.2",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.4.6",
		"tsx": "^4.22.4",
		"typescript": "^5.9.3",
		"vite": "^7.3.5",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@convex-dev/better-auth": "^0.12.5",
		"@jessepomeroy/admin": "6.1.0",
		"@jessepomeroy/gallery-delivery": "workspace:^",
		"@jessepomeroy/print-catalog": "workspace:^",
		"@lucide/svelte": "^0.563.1",
		"@mmailaender/convex-better-auth-svelte": "^0.8.0",
		"@sentry/node": "^10.62.0",
		"@sentry/sveltekit": "^10.62.0",
		"@vercel/analytics": "^1.6.1",
		"better-auth": "1.6.23",
		"convex": "^1.42.1",
		"convex-svelte": "^0.14.0",
		"react": "^19.2.7",
		"resend": "^6.12.2",
		"sharp": "^0.35.4",
		"stripe": "20.3.1",
		"supports-color": "^10.2.2",
		"svelte-dnd-action": "^0.9.69",
		"three": "^0.185.1"
	},
	"lint-staged": {
		"!(packages/crm-api/convex/_generated/**)*.{js,ts}": [
			"biome check --no-errors-on-unmatched"
		],
		"*.svelte": [
			"biome check --no-errors-on-unmatched",
			"svelte-check --tsconfig ./tsconfig.json"
		]
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@sentry/cli"
		],
		"overrides": {
			"resend@6.12.2>@react-email/render": "-",
			"better-auth@1.6.23>react-dom": "-",
			"uuid@<11.1.1": "11.1.1",
			"cookie@<0.7.0": "^0.7.0",
			"postcss@<8.5.23": "8.5.23",
			"brace-expansion": "5.0.9",
			"browserslist@<=4.28.6": "4.28.7",
			"js-yaml@<3.15.2": "3.15.2",
			"js-yaml@>=4.0.0 <4.3.2": "4.3.2",
			"tar": "7.5.22",
			"undici": "7.29.0",
			"nanoid@<3.3.18": "3.3.18",
			"nanoid@>=4.0.0 <5.1.16": "5.1.16",
			"valibot@<=1.4.1": "1.4.2",
			"vite>esbuild": "0.28.1"
		}
	}
}
