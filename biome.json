{
	"$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noForEach": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noImplicitAnyLet": "off"
			},
			"correctness": {
				"noUnusedVariables": "off",
				"noInvalidPositionAtImportRule": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["src/**", "scripts/**", "!packages/crm-api/convex/_generated"]
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"enabled": false
			},
			"formatter": {
				"enabled": false
			},
			"assist": {
				"enabled": false
			}
		},
		{
			"includes": [
				"src/routes/+layout.svelte",
				"src/routes/orders/+page.svelte",
				"src/lib/components/Footer.svelte",
				"src/lib/components/GalleryModal.svelte"
			],
			"linter": {
				"enabled": true,
				"rules": {
					"suspicious": {
						"noExplicitAny": "error"
					},
					"style": {
						"useConst": "off",
						"useImportType": "off"
					},
					"correctness": {
						"noUnusedImports": "off"
					}
				}
			}
		}
	],
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
